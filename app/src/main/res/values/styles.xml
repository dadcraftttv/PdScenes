<resources>
    <!-- Three looks, all built on the framework Material themes (no extra libraries). -->
    <style name="Theme.PdScenes.Light" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Dark status/navigation icons on the light background. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.PdScenes.Dark" parent="android:Theme.Material.NoActionBar" />

    <!-- Dark theme with true black surfaces, so OLED pixels switch off. -->
    <style name="Theme.PdScenes.Amoled" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
