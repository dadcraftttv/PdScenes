#N canvas 0 50 640 520 10;
#X text 10 5 PdScenes: left and right to the headphones. DC offset removed \, limited to +-1 \, then scaled by the player's volume: "set v" on #volume (0 to 1 \, 1 until set) and "play 0/1" on #transport (0 mutes);
#X obj 40 90 inlet~;
#X obj 200 90 inlet~;
#X obj 40 120 hip~ 3;
#X obj 200 120 hip~ 3;
#X obj 40 150 clip~ -1 1;
#X obj 200 150 clip~ -1 1;
#X obj 40 250 *~;
#X obj 200 250 *~;
#X obj 40 300 dac~ 1;
#X obj 200 300 dac~ 2;
#X obj 360 90 r #volume;
#X obj 360 120 route set;
#X obj 360 150 t b f;
#X obj 460 90 r #transport;
#X obj 460 120 route play;
#X obj 360 190 expr \$f1 * \$f2;
#X msg 360 220 \$1 50;
#X obj 360 250 line~;
#X obj 500 190 loadbang;
#X obj 500 220 t b b;
#X msg 500 250 1;
#X msg 540 250 1;
