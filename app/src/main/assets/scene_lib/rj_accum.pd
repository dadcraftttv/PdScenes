#N canvas 0 0 640 560 10;
#X text 10 5 rj_accum: relative change of a short-term mean (st seconds) against a long-term mean (lt seconds). Port of the RjDj C external.;
#X obj 20 40 inlet;
#X obj 20 70 route st lt;
#X obj 100 130 expr max(2 \, int($f1 * $f2 / $f3));
#X obj 300 130 expr max(2 \, int($f1 * $f2 / $f3));
#X msg 100 170 size \$1;
#X msg 300 170 size \$1;
#X obj 100 210 rj_accum_mean;
#X obj 300 210 rj_accum_mean;
#X obj 20 150 t f f;
#X obj 20 280 expr if($f2 == 0 \, 0 \, ($f1 - $f2) / $f2);
#X obj 20 320 outlet;
#X obj 450 40 loadbang;
#X obj 450 70 t b b b;
#X obj 540 110 samplerate~;
#X obj 500 150 expr if(\$1 > 0 && \$2 == 0 \, \$1 \, 512) + 0 * $f1;
#X obj 450 200 t b b;
#X msg 450 230 5;
#X msg 500 230 30;
