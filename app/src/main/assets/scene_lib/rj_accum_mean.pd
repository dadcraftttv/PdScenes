#N canvas 0 0 640 620 10;
#X text 10 5 rj_accum_mean: mean of the last N floats. 'size N' resizes the window and resets it. Helper for rj_accum.;
#X obj 20 40 inlet;
#X obj 20 70 route size;
#X obj 20 110 max 2;
#X obj 20 140 t f f f;
#X obj 20 170 t b f;
#X msg 20 200 resize \$1;
#X msg 100 200 const 0;
#X obj 20 230 s \$0-buf;
#X obj 150 180 t b;
#X msg 150 210 0;
#X obj 480 40 table \$0-buf 2;
#X obj 300 250 f;
#X obj 350 250 f;
#X obj 400 250 f;
#X obj 450 250 f 2;
#X obj 20 300 t f b b b b;
#X obj 300 330 t f f;
#X obj 340 360 tabread \$0-buf;
#X obj 20 400 tabwrite \$0-buf;
#X obj 20 340 t f f;
#X obj 20 440 expr $f3 - $f2 + $f1 \; ($f4 + 1) % $f6 \; if($f5 < $f6 - 1 \, $f5 + 1 \, $f5) \; if(if($f5 < $f6 - 1 \, $f5 + 1 \, $f5) == 0 \, 0 \, ($f3 - $f2 + $f1) / if($f5 < $f6 - 1 \, $f5 + 1 \, $f5));
