#N canvas 28 259 520 320 10;
#X text 20 10 [rj_text some words]: shows text on the scene pad (a 320 x 320 grid) - PdScenes. Messages: text <words> \, visible 0/1 \, move x y (its centre) \, size <points> \, alpha 0-1 \, rotate degrees. It starts shown \, in the middle.;
#X obj 20 80 inlet;
#X obj 160 80 loadbang;
#X msg 160 110 args;
#X obj 160 140 pdcontrol;
#X obj 160 170 list prepend text;
#X obj 20 200 list prepend \$0;
#X obj 20 230 list trim;
#X obj 20 260 s rj_gfx;
#X connect 1 0 6 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
